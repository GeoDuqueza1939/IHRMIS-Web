<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="<%= baseDir %>">
  <title>Sign in - IHRMIS</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      color: #ffffff;
      background:
        radial-gradient(circle at 12% 15%, rgba(241, 169, 37, 0.22), transparent 40%),
        linear-gradient(120deg, #0a2547 0%, #0e3a6d 48%, #1b548f 100%);
      position: relative;
      overflow: hidden;
    }

    body::after {
      content: "";
      position: absolute;
      width: 52vmin;
      height: 52vmin;
      right: -10vmin;
      bottom: -10vmin;
      background: url("/images/Department_of_Education.svg") center / contain no-repeat;
      opacity: 0.10;
      pointer-events: none;
    }

    .topbar {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      padding: 1.1rem clamp(1rem, 4vw, 2.5rem);
    }

    .topbar .brand {
      display: flex;
      align-items: center;
      gap: 0.7rem;
    }

    .topbar .brand img {
      width: 36px;
      height: 36px;
      object-fit: contain;
      border-radius: 50%;
      background: #ffffff;
      padding: 2px;
    }

    .topbar .brand .name {
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.05em;
    }

    .topbar .brand .name span {
      font-weight: 400;
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      color: #c6d9ef;
    }

    .topbar nav a {
      margin-left: 1.4rem;
      font-size: 0.86rem;
      color: #dbe7f6;
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .topbar nav a:hover { color: #ffe9b3; }

    .hero {
      flex: 1;
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem clamp(1rem, 4vw, 2.5rem);
    }

    .card {
      width: min(420px, 100%);
      background: rgba(255, 255, 255, 0.12);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.24);
      border-radius: 20px;
      padding: clamp(1.6rem, 4vw, 2.5rem);
      box-shadow: 0 24px 60px rgba(3, 14, 30, 0.40);
    }

    .card .head {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      margin-bottom: 1.4rem;
    }

    .card .head img {
      width: 52px;
      height: 52px;
      object-fit: contain;
      border-radius: 50%;
      background: #ffffff;
      padding: 3px;
    }

    .card h2 {
      font-size: 1.25rem;
      letter-spacing: 0.03em;
    }

    .card .head p {
      font-size: 0.76rem;
      color: #dbe7f6;
      line-height: 1.35;
    }

    .field {
      position: relative;
      margin-bottom: 1.35rem;
    }

    .field input[type="text"],
    .field input[type="password"] {
      width: 100%;
      padding: 1.35rem 0.95rem 0.5rem;
      font-size: 0.95rem;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.16);
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 10px;
      outline: none;
      transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input::placeholder { color: rgba(255, 255, 255, 0.65); }

    .field input[type="text"]:focus,
    .field input[type="password"]:focus {
      background: rgba(255, 255, 255, 0.24);
      border-color: #ffc948;
      box-shadow: 0 0 0 3px rgba(241, 169, 37, 0.30);
    }

    .field label {
      position: absolute;
      left: 0.95rem;
      top: 50%;
      transform: translateY(-50%);
      font-size: 0.95rem;
      font-weight: 400;
      letter-spacing: 0.01em;
      text-transform: none;
      color: rgba(255, 255, 255, 0.65);
      pointer-events: none;
      transition: top 0.2s ease, transform 0.2s ease, font-size 0.2s ease,
                  color 0.2s ease, font-weight 0.2s ease, letter-spacing 0.2s ease;
    }

    .field input:focus ~ label,
    .field input:not(:placeholder-shown) ~ label {
      top: 0.55rem;
      transform: none;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #ffe9b3;
    }

    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      flex-wrap: wrap;
      font-size: 0.8rem;
      margin: 0.1rem 0 1.25rem;
    }

    .check {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #dbe7f6;
      cursor: pointer;
    }

    .check input { accent-color: #f1a925; }

    .row a {
      color: #ffe9b3;
      text-decoration: none;
      font-weight: 600;
    }

    .row a:hover { text-decoration: underline; }

    button {
      width: 100%;
      padding: 0.84rem;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #0e3a6d;
      background: linear-gradient(180deg, #ffc948 0%, #f1a925 100%);
      border: none;
      border-radius: 10px;
      cursor: pointer;
      box-shadow: 0 10px 24px rgba(3, 14, 30, 0.35);
      transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
    }

    button:hover {
      filter: brightness(1.05);
      transform: translateY(-1px);
    }

    button:active { transform: translateY(0); }

    .or-divider {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1.25rem 0 1rem;
      color: #c6d9ef;
      font-size: 0.76rem;
      white-space: nowrap;
    }

    .or-divider::before,
    .or-divider::after {
      content: "";
      flex: 1;
      height: 1px;
      background: rgba(255, 255, 255, 0.22);
    }

    .sso {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .sso-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      width: 100%;
      padding: 0.72rem 0.8rem;
      font-size: 0.86rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: #ffffff;
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.32);
      border-radius: 10px;
      cursor: pointer;
      box-shadow: none;
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

    .sso-btn:hover {
      background: rgba(255, 255, 255, 0.22);
      border-color: #ffc948;
      box-shadow: none;
      filter: none;
      transform: translateY(-1px);
    }

    .sso-btn:active {
      transform: translateY(0);
      box-shadow: none;
    }

    .sso-icon {
      width: 18px;
      height: 18px;
      flex: none;
    }

    .bottombar {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 1rem clamp(1rem, 4vw, 2.5rem);
      font-size: 0.8rem;
      color: #bcd2ee;
    }

    .bottombar a {
      color: #dbe7f6;
      text-decoration: none;
    }

    .bottombar a:hover { color: #ffe9b3; text-decoration: underline; }

    .bottombar .divider { margin: 0 0.5rem; opacity: 0.5; }

    @media (max-width: 640px) {
      .topbar nav a.optional { display: none; }
      .hero { padding: 1.5rem 1rem; }
      .card { border-radius: 16px; padding: 1.6rem 1.25rem; }
      .bottombar { font-size: 0.72rem; line-height: 1.9; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <img src="/images/logo-depedstotomas.webp" alt="DepEd Sto. Tomas logo" />
      <div class="name">IHRMIS <span>&middot; Integrated Human Resource Management Information System</span></div>
    </div>
    <nav>
      <a href="#">About</a>
      <a href="#" class="optional">PRIME-HRM</a>
      <a href="#" class="optional">Help</a>
    </nav>
  </header>

  <main class="hero">
    <div class="card">
      <div class="head">
        <img src="/images/logo-depedstotomas.webp" alt="DepEd Sto. Tomas logo" />
        <div>
          <h2>Sign in</h2>
          <p>Schools Division of Sto. Tomas &middot; Department of Education</p>
        </div>
      </div>

      <form method="POST" action="/login/3">
        <div class="field">
          <input type="text" id="username" name="username" placeholder=" "
                 value="<%= username %>" autocomplete="username" required />
          <label for="username">Username</label>
        </div>
        <div class="field">
          <input type="password" id="password" name="password" placeholder=" "
                 autocomplete="current-password" required />
          <label for="password">Password</label>
        </div>
        <div class="row">
          <label class="check"><input type="checkbox" name="remember" /> Remember me</label>
          <a href="#">Forgot password?</a>
        </div>
        <button type="submit">Sign in</button>

        <div class="or-divider">or continue with</div>
        <div class="sso">
          <button type="button" class="sso-btn" aria-label="Sign in with DepEd Google">
            <svg class="sso-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" />
              <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" />
              <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z" />
              <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z" />
            </svg>
            <span>Sign in with DepEd Google</span>
          </button>
          <button type="button" class="sso-btn" aria-label="Sign in with DepEd Microsoft 365">
            <svg class="sso-icon" viewBox="0 0 23 23" aria-hidden="true">
              <path fill="#F25022" d="M1 1h10v10H1z" />
              <path fill="#7FBA00" d="M12 1h10v10H12z" />
              <path fill="#00A4EF" d="M1 12h10v10H1z" />
              <path fill="#FFB900" d="M12 12h10v10H12z" />
            </svg>
            <span>Sign in with Microsoft 365</span>
          </button>
        </div>
      </form>
    </div>
  </main>

  <footer class="bottombar">
    <a href="#">About IHRMIS</a><span class="divider">&middot;</span>
    <a href="#">PRIME-HRM</a><span class="divider">&middot;</span>
    <a href="#">Data Privacy Act (RA 10173)</a><span class="divider">&middot;</span>
    <a href="#">E-Governance Act (RA 12254)</a>
  </footer>
</body>
</html>