  </script>
  <script src="/js/elements.js"></script>
  <script src="/js/tab.js"></script>
  <script>
    "use strict";

    Array.from(document.getElementsByClassName("tabbed-display")).forEach(tabbedDisplay=>{
        new TabControl(tabbedDisplay, 'Employee record sections');
    });

  </script>
</body>
</html>
