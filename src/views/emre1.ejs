<!DOCTYPE html>
<html lang="en" data-theme="navy">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="<%= baseDir %>">
  <title>Employee Record Viewer</title>
  <link rel="stylesheet" href="/styles/default.css">
  <link rel="stylesheet" href="/styles/tab.css">
  <link rel="stylesheet" href="/styles/themes.css">
  <link rel="stylesheet" href="/styles/emre.css">
</head>
<body>
    <main class="employee-data">
        <h1>Employee Record</h1>
        <aside class="photo">
            <img src="<%= (typeof employee == 'undefined' || !employee.photo_fpath ? '/images/photo_placeholder.svg' : employee.photo_fpath) %>" alt="Employee Photo" />
        </aside>

        <section class="summary">
            <p class="data name"><span class="label">Name:</span> <span class="value">Dela Cruz, Juan Santos</span></p>
            <p class="data position"><span class="label">Position:</span> <span class="value">Administrative Officer I</span></p>
            <p class="data unit"><span class="label">Office/Unit:</span> <span class="value">Sto. Tomas North Central School</span></p>
            <p class="data empno"><span class="label">Employee No.:</span> <span class="value">0000000</span></p>
            <p class="data"><span class="label">Salary Grade and Step:</span> <span class="value">10-1</span></p>
            <p class="data"><span class="label">Salary/Wage:</span> <span class="value">&#x20b1; 21,234.00</span></p>
            <p class="data"><span class="label">Employment Status:</span> <span class="value">ACTIVE DUTY since January 1, 2000</span></p>
            <p class="data"><span class="label">Designations:</span> <span class="value">NONE</span></p>
        </section>

        <section class="tabbed-display">
            <section class="tab-panel job-description" id="tab-job">
                <h2 class="tab" title="Job Description/Duties and Responsibilities">Job Description</h2>
                
                <section class="position">
                    <p class="data"><span class="label">Position:</span> <span class="value">Administrative Officer I</span></p>
                    <p class="data"><span class="label">Office/Unit:</span> <span class="value">Sto. Tomas North Central School</span></p>
                    <p class="data"><span class="label">Description:</span> <span class="value"></span></p>

                    <table class="data-table">
                        <caption>Duties and Responsibilities</caption>
                        <thead>
                            <th>Domain/Key Result Area</th>
                            <th>Duties/Responsibilities</th>
                        </thead>
                    </table>
                </section>

                <section class="designation">
                    <p class="data"><span class="label">Designation:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Office/Unit:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Concurrent:</span> <span class="value">Yes</span></p>

                    <p class="data"><span class="label">Description:</span> <span class="value"></span></p>

                    <table class="data-table">
                        <caption>Terms of Reference</caption>
                        <thead>
                            <th>#</th>
                            <th>Duties/Responsibilities</th>
                        </thead>
                    </table>
                </section>
            </section>
            <section class="tab-panel personal-data" id="tab-personal">
                <h2 class="tab" title="Personal Data">Personal Data</h2>
                <div class="data-grp">
                    <p class="data"><span class="label">Surname:</span> <span class="value">Dela Cruz</span></p>
                    <p class="data"><span class="label">First Name:</span> <span class="value">Juan</span></p>
                    <p class="data"><span class="label">Name Extension (Jr., Sr.):</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Middle Name:</span> <span class="value">Santos</span></p>
                    <p class="data"><span class="label">Age:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Date of Birth:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Place of Birth:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Sex at Birth:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Civil Status:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Height (m):</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Weight (kg):</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Blood Type:</span> <span class="value"></span></p>
                </div>

                <div class="data-grp">
                    <h3>Identification</h3>
                    <p class="data"><span class="label">UMID ID No.:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">Pag-IBIG ID No.:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">PhilHealth No.:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">PhilSys Number (PSN):</span> <span class="value"></span></p>
                    <p class="data"><span class="label">TIN No.:</span> <span class="value"></span></p>
                    <p class="data"><span class="label">School ID:</span> <span class="value"></span></p>

                </div>

                <div class="data-grp">
                    <h3>Family Background</h3>
                    <div class="data-subgrp">
                        <h4>Spouse Information</h4>
                        <p class="data"><span class="label">Name:</span> <span class="value"></span></p>
                        <p class="data"><span class="label">Occupation:</span> <span class="value"></span></p>
                        <p class="data"><span class="label">Employer/Business Name:</span> <span class="value"></span></p>
                        <p class="data"><span class="label">Business Address:</span> <span class="value"></span></p>
                        <p class="data"><span class="label">Telephone No.:</span> <span class="value"></span></p>
                    </div>

                    <div class="data-subgrp">
                        <h4>Parents</h4>
                        <p class="data"><span class="label">Father's Name:</span> <span class="value"></span></p>
                        <p class="data"><span class="label">Mother's Maiden Name:</span> <span class="value"></span></p>
                    </div>

                    <table class="data-subgrp-table">
                        <caption>Children</caption>
                      <thead>
                            <th>Name</th>
                            <th>Date of Birth</th>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </section>
            <section class="tab-panel education-data" id="tab-education">
                <h2 class="tab" title="Education">Education</h2>
                <table class="data-grp-table">
                    <caption>Education</caption>
                    <thead>
                        <tr>
                            <th rowspan="2">#</th>
                            <th rowspan="2">Level</th>
                            <th rowspan="2">Name of School</th>
                            <th rowspan="2">Basic Education/&ZeroWidthSpace;Degree/&ZeroWidthSpace;Course</th>
                            <th colspan="2">Period of Attendance</th>
                            <th rowspan="2">Highest Level/Units Earned (if not graduated)</th>
                            <th rowspan="2">Year Graduated</th>
                            <th rowspan="2">Scholarship/Academic Honors Received</th>
                        </tr>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
            <section class="tab-panel training-data" id="tab-training">
                <h2 class="tab" title="Learning and Development (L&D) Interventions/Training Programs Attended">Training</h2>
                <table class="data-grp-table">
                    <thead>
                        <th rowspan="2">#</th>
                        <th rowspan="2">Title of Learning and Development Interventions/Training Programs</th>
                        <th colspan="2">Inclusive Dates of Attendance (dd/mm/yyyy)</th>
                        <th rowspan="2">Number of Hours</th>
                        <th rowspan="2">Type of L&D (Managerial/Supervisory/Technical/etc.)</th>
                        <th rowspan="2">Conducted/Sponsored by</th>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
            <section class="tab-panel work-data" id="tab-work">
                <h2 class="tab" title="Work Experience">Work Experience</h2>
                <table class="data-grp-table">
                    <thead>
                        <tr>
                            <th rowspan="2">#</th>
                            <th colspan="2">Inclusive Dates (dd/mm/yyyy)</th>
                            <th rowspan="2">Position Title</th>
                            <th rowspan="2">Department/Agency/Office/Company</th>
                            <th rowspan="2">Status of Appointment</th>
                            <th rowspan="2">Government Service (Y/N)</th>
                        </tr>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
            <section class="tab-panel eligibility-data" id="tab-eligibility">
                <h2 class="tab" title="Civil Service Eligibility">Civil Service Eligibility</h2>
                <table class="data-grp-table">
                    <thead>
                        <tr>
                            <th rowspan="2">#</th>
                            <th rowspan="2">CES/CSEE/Career Service/RA 1080 (Board/Bar)/Under Special Laws/Category II/IV Eligibility and Eligibilities for Uniformed Personnel</th>
                            <th rowspan="2">Rating (if applicable)</th>
                            <th rowspan="2">Date of Examination/Conferment</th>
                            <th rowspan="2">Place of Examination/Conferment</th>
                            <th colspan="2">License (if applicable)</th>
                        </tr>
                        <tr>
                            <th>Number (if applicable)</th>
                            <th>Valid Until</th>
                    <tbody></tbody>
                </table>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
            <section class="tab-panel service-record" id="tab-service">
                <h2 class="tab" title="Service Record">Service Record</h2>

            </section>
            <section class="tab-panel awards-data" id="tab-awards">
                <h2 class="tab" title="Awards and Recognitions">Awards</h2>

            </section>
            <section class="tab-panel voluntary-work-data" id="tab-voluntary">
                <h2 class="tab" title="Voluntary Work or Involvement in Civic/Non-Government/People/Voluntary Organization(s)">Voluntary Work</h2>
                <table class="data-grp-table">
                    <thead>
                        <tr>
                            <th rowspan="2">#</th>
                            <th rowspan="2">Name &amp; Address of Organization</th>
                            <th colspan="2">Inclusive Dates (dd/mm/yyyy)</th>
                            <th rowspan="2">Number of Hours</th>
                            <th rowspan="2">Position/Nature of Work</th>
                        </tr>
                        <tr>
                            <th>From</th>
                            <th>To</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </section>
        </section>
    </main>
  <script>
