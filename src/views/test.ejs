<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="<%= baseDir %>">
  <title>Test Page</title>
  <style>
    * {
      box-sizing: border-box;
    }

    .data-box {
      display: block;
      border: 2px inset black;
      margin: 1em;
      padding: 0.25em;
    }
  </style>
</head>
<body>
  <h2>Test Input</h2>
  <form method="POST" action="<%= baseDir %>/test">
    <label for="testinput">Enter test data:</label>
    <input id="testinput" name="testinput" type="text" placeholder="Test data" />
    <button type="submit">Submit</button>
  </form>
  <div class="data-box">
    <%= testdata.body == null ? 'No test data provided' : testdata.body.testinput %><br>
    <% // console.log(testdata.route.methods) %>
  </div>

  <h2>Available Sample Layouts</h2>
  <ul><% for(url in JSON.parse(urls)) { %>
    <li><a href="<%= JSON.parse(urls)[url] %>"><%= JSON.parse(urls)[url] %></a></li><% } %>
  </ul>
</body>
</html>
