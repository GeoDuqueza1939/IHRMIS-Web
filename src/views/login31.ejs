<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="<%= baseDir %>">
  <title>Sign in - IHRMIS</title>
  <link rel="stylesheet" href="/styles/default.css">
  <link rel="stylesheet" href="/styles/login.css">
</head>
<body class="login">
    <header class="topbar">
        <div class="brand">
            <img src="/images/logo-depedstotomas.webp" alt="logo: DepEd Sto. Tomas City">
            <h1 class="name"><span class="full-name">Integrated Human Resource Management Information System </span><abbrev>IHRMIS </abbrev>&middot; <span class="full-name">Department of Education </span><abbrev>DepEd </abbrev>&middot; SDO Sto. Tomas City</h1>
        </div>
        <nav>
            <ul>
                <li><a href="#">About</a></li>
                <li><a href="#">PRIME-HRM</a></li>
                <li><a href="#">Help</a></li>
            </ul>
        </nav>
    </header>
    
    <div class="layout">
        <aside class="carousel">
            <div class="slide">
                <div class="mark">RSP</div>
                <h3>Recruitment, Selection &amp; Placement</h3>
                <p>Guided hiring cycles, HRMPSB evaluations, and transparent screening for every position.</p>
            </div>
            <div class="slide">
                <div class="mark">PM</div>
                <h3>Performance Management</h3>
                <p>Manage performance cycles and track ratings from planning through to final review.</p>
            </div>
            <div class="slide">
                <div class="mark">L&amp;D</div>
                <h3>Learning &amp; Development</h3>
                <p>Plan interventions, invite participants, and keep training records up to date.</p>
            </div>
            <div class="slide">
                <div class="mark">R&amp;R</div>
                <h3>Rewards &amp; Recognition</h3>
                <p>Nominate and celebrate excellence through PRAISE-aligned award cycles.</p>
            </div>
            <div class="dots">
                <span></span><span></span><span></span><span></span>
            </div>
        </aside>
        
        <main class="login-form">
            <div class="head">
                <img src="/images/logo-depedstotomas.webp" alt="DepEd Sto. Tomas logo" />
                <div>
                    <h2>IHRMIS &middot; Sign in</h2>
                    <!-- <p>Schools Division of Sto. Tomas &middot; Department of Education</p> -->
                </div>
            </div>
            
            <form method="POST" action="<%= baseDir %>/janus/login">
                <% if (typeof error !== 'undefined' && error) { %>
                <p class="alert error" role="alert"><%= error %></p>
                <% } %>
                <% if (typeof warning !== 'undefined' && warning) { %>
                <p class="alert warn" role="alert"><%= warning %></p>
                <% } %>
                <!-- <p class="hint">Email sign-in is for applicants, JO/COS, and new hires without a DepEd email. DepEd (@deped.gov.ph) accounts must use Google or Microsoft 365 below.</p> -->
                <div class="field">
                    <input type="text" id="username" name="username" placeholder=" " value="<%= typeof username !== 'undefined' ? username : '' %>" autocomplete="username" required />
                    <label for="username">Username</label>
                </div>
                <div class="field">
                    <input type="password" id="password" name="password" placeholder=" " autocomplete="current-password" required />
                    <label for="password">Password</label>
                </div>
                <div class="row">
                    <label class="check"><input type="checkbox" name="remember" /> Remember me</label>
                    <a href="<%= baseDir %>/janus/forgot">Forgot password?</a>
                </div>
                <button type="submit">Sign in</button>

                <div class="or-divider">or continue with</div>
                <div class="sso">
                <a class="sso-btn" aria-label="Sign in with DepEd Google" href="<%= baseDir %>/janus/auth/google">
                    <svg class="sso-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.47c-.29 1.48-1.14 2.73-2.4 3.58v3h3.86c2.26-2.09 3.56-5.17 3.56-8.82z" />
                        <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09C3.26 21.3 7.31 24 12 24z" />
                        <path fill="#FBBC05" d="M5.27 14.29c-.25-.72-.38-1.49-.38-2.29s.14-1.57.38-2.29V6.62H1.29C.47 8.24 0 10.06 0 12s.47 3.76 1.29 5.38l3.98-3.09z" />
                        <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.31 0 3.26 2.7 1.29 6.62l3.98 3.09c.95-2.85 3.6-4.96 6.73-4.96z" />
                    </svg>
                    <span>Sign in with DepEd Google</span>
                </a>
                <a class="sso-btn" aria-label="Sign in with DepEd Microsoft 365" href="<%= baseDir %>/janus/auth/ms365">
                    <svg class="sso-icon" viewBox="0 0 23 23" aria-hidden="true">
                        <path fill="#F25022" d="M1 1h10v10H1z" />
                        <path fill="#7FBA00" d="M12 1h10v10H12z" />
                        <path fill="#00A4EF" d="M1 12h10v10H1z" />
                        <path fill="#FFB900" d="M12 12h10v10H12z" />
                    </svg>
                    <span>Sign in with Microsoft 365</span>
                </a>
                </div>
            </form>
        </main>
    </div>

    <footer class="bottom-bar">
        <ul>
            <li><a href="#">About IHRMIS</a></li>
            <li><a href="#">PRIME-HRM</a></li>
            <li><a href="#">Data Privacy Act (RA 10173)</a></li>
            <li><a href="#">E-Governance Act (RA 12254)</a></li>
        </ul>
    </footer>
</body>
</html>