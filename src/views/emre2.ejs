<!DOCTYPE html>
<html lang="en" data-theme="navy">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <base href="<%= baseDir %>">
  <title>Employee Record - IHRMIS</title>
  <link rel="stylesheet" href="/styles/default.css">
  <link rel="stylesheet" href="/styles/themes.css">
  <link rel="stylesheet" href="/styles/emre2.css">
</head>
<body class="dossier">

  <header class="dossier-bar">
    <div class="dossier-bar__brand">
      <img src="/images/logo-depedstotomas.webp" alt="Department of Education" />
      <span class="dossier-bar__system">IHRMIS</span>
      <span class="dossier-bar__sep" aria-hidden="true">/</span>
      <span class="dossier-bar__page">Employee Record</span>
    </div>
    <div class="dossier-bar__meta">
      <span class="dossier-bar__empno">Employee No. <b>0000000</b></span>
      <span class="dossier-bar__status">Active Duty</span>
    </div>
  </header>

  <div class="dossier-body">

    <aside class="rail">
      <figure class="portrait">
        <img src="<%= (typeof employee == 'undefined' || !employee.photo_fpath ? '/images/photo_placeholder.svg' : employee.photo_fpath) %>" alt="Employee Photo" />
      </figure>

      <div class="identity">
        <h1 class="identity__name">Dela Cruz, Juan Santos</h1>
        <p class="identity__role">Administrative Officer I</p>
        <p class="identity__unit">Sto. Tomas North Central School</p>
      </div>

      <dl class="facts">
        <div class="facts__row"><dt>Employee No.</dt><dd>0000000</dd></div>
        <div class="facts__row"><dt>Salary Grade &amp; Step</dt><dd>10-1</dd></div>
        <div class="facts__row"><dt>Monthly Pay</dt><dd>&#x20b1; 21,234.00</dd></div>
        <div class="facts__row"><dt>Employment Status</dt><dd>Active Duty</dd></div>
        <div class="facts__row"><dt>Designations</dt><dd>None</dd></div>
      </dl>

      <nav class="sections" aria-label="Record sections">
        <ul class="sections__list" role="tablist" aria-orientation="vertical">
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-job" role="tab" aria-selected="true" aria-controls="sec-job">Job Description</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-personal" role="tab" aria-selected="false" aria-controls="sec-personal" tabindex="-1">Personal Data</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-education" role="tab" aria-selected="false" aria-controls="sec-education" tabindex="-1">Education</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-training" role="tab" aria-selected="false" aria-controls="sec-training" tabindex="-1">Training</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-work" role="tab" aria-selected="false" aria-controls="sec-work" tabindex="-1">Work Experience</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-eligibility" role="tab" aria-selected="false" aria-controls="sec-eligibility" tabindex="-1">Civil Service Eligibility</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-service" role="tab" aria-selected="false" aria-controls="sec-service" tabindex="-1">Service Record</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-awards" role="tab" aria-selected="false" aria-controls="sec-awards" tabindex="-1">Awards</button></li>
          <li role="presentation"><button type="button" class="sections__tab" id="tab-sec-voluntary" role="tab" aria-selected="false" aria-controls="sec-voluntary" tabindex="-1">Voluntary Work</button></li>
        </ul>
      </nav>
    </aside>

    <main class="content">
      <div class="content__bar">
        <h2 class="content__title" data-section-title>Job Description</h2>
        <div class="content__tools">
          <span class="content__count" data-section-count>1 of 9</span>
          <button type="button" class="pager__btn" data-section-prev>&lsaquo; Previous</button>
          <button type="button" class="pager__btn" data-section-next>Next &rsaquo;</button>
        </div>
      </div>

      <!-- 1 -->
      <section class="section selected" id="sec-job" role="tabpanel" aria-labelledby="tab-sec-job" tabindex="0">
        <div class="block">
          <h3 class="block__title">Position</h3>
          <div class="rows">
            <p class="data"><span class="label">Position</span><span class="value">Administrative Officer I</span></p>
            <p class="data"><span class="label">Office/Unit</span><span class="value">Sto. Tomas North Central School</span></p>
            <p class="data"><span class="label">Description</span><span class="value"></span></p>
          </div>
        </div>

        <div class="block">
          <h3 class="block__title">Duties and Responsibilities</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>Domain/Key Result Area</th>
                <th>Duties/Responsibilities</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>

        <div class="block">
          <h3 class="block__title">Designation</h3>
          <div class="rows">
            <p class="data"><span class="label">Designation</span><span class="value"></span></p>
            <p class="data"><span class="label">Office/Unit</span><span class="value"></span></p>
            <p class="data"><span class="label">Concurrent</span><span class="value">Yes</span></p>
            <p class="data"><span class="label">Description</span><span class="value"></span></p>
          </div>
        </div>

        <div class="block">
          <h3 class="block__title">Terms of Reference</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Duties/Responsibilities</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 2 -->
      <section class="section" id="sec-personal" role="tabpanel" aria-labelledby="tab-sec-personal" tabindex="0">
        <div class="block">
          <h3 class="block__title">Personal Data</h3>
          <div class="rows">
            <p class="data"><span class="label">Surname</span><span class="value">Dela Cruz</span></p>
            <p class="data"><span class="label">First Name</span><span class="value">Juan</span></p>
            <p class="data"><span class="label">Name Extension</span><span class="value"></span></p>
            <p class="data"><span class="label">Middle Name</span><span class="value">Santos</span></p>
            <p class="data"><span class="label">Age</span><span class="value"></span></p>
            <p class="data"><span class="label">Date of Birth</span><span class="value"></span></p>
            <p class="data"><span class="label">Place of Birth</span><span class="value"></span></p>
            <p class="data"><span class="label">Sex at Birth</span><span class="value"></span></p>
            <p class="data"><span class="label">Civil Status</span><span class="value"></span></p>
            <p class="data"><span class="label">Height (m)</span><span class="value"></span></p>
            <p class="data"><span class="label">Weight (kg)</span><span class="value"></span></p>
            <p class="data"><span class="label">Blood Type</span><span class="value"></span></p>
          </div>
        </div>

        <div class="block">
          <h3 class="block__title">Identification</h3>
          <div class="rows">
            <p class="data"><span class="label">UMID ID No.</span><span class="value"></span></p>
            <p class="data"><span class="label">Pag-IBIG ID No.</span><span class="value"></span></p>
            <p class="data"><span class="label">PhilHealth No.</span><span class="value"></span></p>
            <p class="data"><span class="label">PhilSys Number</span><span class="value"></span></p>
            <p class="data"><span class="label">TIN No.</span><span class="value"></span></p>
            <p class="data"><span class="label">School ID</span><span class="value"></span></p>
          </div>
        </div>

        <div class="block">
          <h3 class="block__title">Family Background</h3>
          <h4 class="block__subtitle">Spouse Information</h4>
          <div class="rows">
            <p class="data"><span class="label">Name</span><span class="value"></span></p>
            <p class="data"><span class="label">Occupation</span><span class="value"></span></p>
            <p class="data"><span class="label">Employer/Business Name</span><span class="value"></span></p>
            <p class="data"><span class="label">Business Address</span><span class="value"></span></p>
            <p class="data"><span class="label">Telephone No.</span><span class="value"></span></p>
          </div>

          <h4 class="block__subtitle">Parents</h4>
          <div class="rows">
            <p class="data"><span class="label">Father's Name</span><span class="value"></span></p>
            <p class="data"><span class="label">Mother's Maiden Name</span><span class="value"></span></p>
          </div>

          <h4 class="block__subtitle">Children</h4>
          <table class="data-subgrp-table">
            <thead>
              <tr>
                <th>Name</th>
                <th>Date of Birth</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 3 -->
      <section class="section" id="sec-education" role="tabpanel" aria-labelledby="tab-sec-education" tabindex="0">
        <div class="block">
          <h3 class="block__title">Education</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Level</th>
                <th>Name of School</th>
                <th>Basic Education/Degree/Course</th>
                <th>From</th>
                <th>To</th>
                <th>Highest Level/Units Earned</th>
                <th>Year Graduated</th>
                <th>Scholarship/Academic Honors</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 4 -->
      <section class="section" id="sec-training" role="tabpanel" aria-labelledby="tab-sec-training" tabindex="0">
        <div class="block">
          <h3 class="block__title">Learning and Development Interventions / Training Programs Attended</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Title of L&D Interventions / Training Programs</th>
                <th>From</th>
                <th>To</th>
                <th>Number of Hours</th>
                <th>Type of L&D</th>
                <th>Conducted/Sponsored by</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 5 -->
      <section class="section" id="sec-work" role="tabpanel" aria-labelledby="tab-sec-work" tabindex="0">
        <div class="block">
          <h3 class="block__title">Work Experience</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>From</th>
                <th>To</th>
                <th>Position Title</th>
                <th>Department/Agency/Office/Company</th>
                <th>Status of Appointment</th>
                <th>Government Service (Y/N)</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 6 -->
      <section class="section" id="sec-eligibility" role="tabpanel" aria-labelledby="tab-sec-eligibility" tabindex="0">
        <div class="block">
          <h3 class="block__title">Civil Service Eligibility</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>CES/CSEE/Career Service/RA 1080 (Board/Bar)/Under Special Laws/Category II/IV Eligibility and Eligibilities for Uniformed Personnel</th>
                <th>Rating (if applicable)</th>
                <th>Date of Examination/Conferment</th>
                <th>Place of Examination/Conferment</th>
                <th>License No. (if applicable)</th>
                <th>Valid Until</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>

      <!-- 7 -->
      <section class="section" id="sec-service" role="tabpanel" aria-labelledby="tab-sec-service" tabindex="0">
        <div class="block">
          <h3 class="block__title">Service Record</h3>
          <p class="empty">No service record entries have been encoded yet.</p>
        </div>
      </section>

      <!-- 8 -->
      <section class="section" id="sec-awards" role="tabpanel" aria-labelledby="tab-sec-awards" tabindex="0">
        <div class="block">
          <h3 class="block__title">Awards and Recognitions</h3>
          <p class="empty">No awards or recognitions have been encoded yet.</p>
        </div>
      </section>

      <!-- 9 -->
      <section class="section" id="sec-voluntary" role="tabpanel" aria-labelledby="tab-sec-voluntary" tabindex="0">
        <div class="block">
          <h3 class="block__title">Voluntary Work or Involvement in Civic / Non-Government / People / Voluntary Organization(s)</h3>
          <table class="data-grp-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Name &amp; Address of Organization</th>
                <th>From</th>
                <th>To</th>
                <th>Number of Hours</th>
                <th>Position/Nature of Work</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>

  <script src="/js/sections.js"></script>
  <script>
    "use strict";

    Array.from(document.getElementsByClassName("dossier-body")).forEach(dossierBody => {
      new SectionSwitcher(dossierBody);
    });
  </script>
</body>
</html>
